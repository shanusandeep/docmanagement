@page "/"
@inject IConfiguration Config
@inject AppOnlyGraphProvider AppOnly
@inject NetworkShareService Share

<PageTitle>Scenario 1 — Transient Editing</PageTitle>

<h1>Scenario 1 — SharePoint as a Temporary Editing Workspace</h1>

<p class="lead">
    The network share remains the system of record. When a user clicks <strong>View/Edit</strong>,
    the document is uploaded to SharePoint (with Track Changes enforced), edited in place in Word
    with autosave and co-authoring, and automatically returned to the network share once everyone
    is done — detected via inactivity plus a SharePoint lock probe. No download, no upload,
    no check-in button.
</p>

<h4>Demo flow</h4>
<ol>
    <li>Go to <a href="documents">Documents</a> — the list comes from the simulated network share (<code>@Share.RootPath</code>).</li>
    <li>Click <strong>View/Edit</strong> — the file is uploaded to SharePoint and opens in Word (desktop) or Office Online.</li>
    <li>Edit — changes autosave to SharePoint; a second user clicking the same document joins the co-authoring session.</li>
    <li>Close Word — after the idle threshold the sweep syncs the file back to the share and deletes it from SharePoint. Watch the activity feed.</li>
</ol>

<h4>Setup status</h4>
<ul class="list-group" style="max-width: 720px">
    <li class="list-group-item d-flex justify-content-between">
        <span>Entra ID (AzureAd) configured — TenantId / ClientId / ClientSecret</span>
        @if (AadConfigured)
        {
            <span class="badge bg-success align-self-center">OK</span>
        }
        else
        {
            <span class="badge bg-warning text-dark align-self-center">Set in appsettings.json / user-secrets</span>
        }
    </li>
    <li class="list-group-item d-flex justify-content-between">
        <span>SharePoint DriveId configured</span>
        @if (DriveConfigured)
        {
            <span class="badge bg-success align-self-center">OK</span>
        }
        else
        {
            <span class="badge bg-warning text-dark align-self-center">Set SharePoint:DriveId</span>
        }
    </li>
    <li class="list-group-item d-flex justify-content-between">
        <span>App-only credentials (background sweep)</span>
        @if (AppOnly.IsConfigured)
        {
            <span class="badge bg-success align-self-center">OK</span>
        }
        else
        {
            <span class="badge bg-secondary align-self-center">Disabled — manual sync still works</span>
        }
    </li>
</ul>

<p class="mt-3 text-muted">
    See <code>README.md</code> for the app-registration and site setup steps
    (redirect URI <code>https://localhost:7191/signin-oidc</code>).
</p>

@code {
    private bool AadConfigured =>
        !(Config["AzureAd:TenantId"] ?? "YOUR_").StartsWith("YOUR_") &&
        !(Config["AzureAd:ClientId"] ?? "YOUR_").StartsWith("YOUR_");

    private bool DriveConfigured =>
        !(Config["SharePoint:DriveId"] ?? "YOUR_").StartsWith("YOUR_");
}
