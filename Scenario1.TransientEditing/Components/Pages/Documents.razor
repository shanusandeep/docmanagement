@page "/documents"
@attribute [Authorize]
@implements IDisposable
@inject TransientDocumentService DocService
@inject SyncBackEngine Sync
@inject NetworkShareService Share
@inject DocumentStateStore Store
@inject ActivityLog Log
@inject Microsoft.Graph.GraphServiceClient Graph
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject Microsoft.Identity.Web.MicrosoftIdentityConsentAndConditionalAccessHandler ConsentHandler

<PageTitle>Manage Documents — SERFIS</PageTitle>

<h1>Manage Documents</h1>

@if (error != null)
{
    <div class="alert alert-danger py-2">@error</div>
}
@if (warning != null)
{
    <div class="alert alert-warning py-2">@warning</div>
}

<div class="sp-card p-2">

    <div class="sp-toolbar d-flex flex-wrap align-items-center gap-1 border rounded px-2 py-1 mb-2 bg-white">
        <label class="btn btn-sm mb-0 @(busy != null ? "disabled" : null)" title="Upload a file into the current folder">
            @if (busy == "upload")
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            else
            {
                <Icon Name="upload" Size="14" />
            }
            <span class="ms-1">Upload file</span>
            <InputFile OnChange="OnUpload" style="display:none" disabled="@(busy != null)" />
        </label>
        <button class="btn btn-sm" title="Create a new Word document here" @onclick="@(() => StartPrompt("newdoc"))" disabled="@(busy != null)">
            <Icon Name="plus" Size="14" /> <span class="ms-1">New document</span>
        </button>
        <button class="btn btn-sm" title="Create a new folder here" @onclick="@(() => StartPrompt("newfolder"))" disabled="@(busy != null)">
            <Icon Name="folder" Size="14" /> <span class="ms-1">New folder</span>
        </button>
        <button class="btn btn-sm" title="Open the selected document in Word for editing (uploads to SharePoint, autosave on)" @onclick="ViewSelected" disabled="@(SelectedDocx == null || busy != null)">
            <Icon Name="word" Size="14" /> <span class="ms-1">View/Edit</span>
        </button>
        @if (SelectedFile is { } pdfSel && IsConvertible(pdfSel.Name))
        {
            <a class="btn btn-sm" title="Download the selected document as PDF"
               href="/api/pdf?path=@Uri.EscapeDataString(pdfSel.RelativePath)" target="_blank">
                <Icon Name="pdf" Size="14" /> <span class="ms-1">PDF</span>
            </a>
        }
        else
        {
            <button class="btn btn-sm" disabled><Icon Name="pdf" Size="14" /> <span class="ms-1">PDF</span></button>
        }
        @if (SelectedFile is { } dlSel)
        {
            <a class="btn btn-sm" title="Download the selected document"
               href="/api/download?path=@Uri.EscapeDataString(dlSel.RelativePath)">
                <Icon Name="download" Size="14" /> <span class="ms-1">Download</span>
            </a>
        }
        else
        {
            <button class="btn btn-sm" disabled><Icon Name="download" Size="14" /> <span class="ms-1">Download</span></button>
        }
        <button class="btn btn-sm" title="Rename the selected item" @onclick="@(() => StartPrompt("rename"))" disabled="@(Selected == null || busy != null)">
            <Icon Name="pencil" Size="14" /> <span class="ms-1">Rename</span>
        </button>
        <button class="btn btn-sm text-danger" title="Delete the selected item" @onclick="@(() => confirmingDelete = Selected)" disabled="@(Selected == null || busy != null)">
            <Icon Name="trash" Size="14" /> <span class="ms-1">Delete</span>
        </button>
        @if (SelectedState != null)
        {
            <button class="btn btn-sm" title="Sync this document back to the network share now" @onclick="SyncSelected" disabled="@(busy != null)">
                <Icon Name="restore" Size="14" /> <span class="ms-1">Sync back</span>
            </button>
        }
        <button class="btn btn-sm ms-auto" title="Run the sync-back sweep now (simulates the scheduled job)" @onclick="RunSweep" disabled="@(busy != null)">
            <Icon Name="history" Size="14" />
        </button>
        <button class="btn btn-sm" title="Refresh" @onclick="Refresh" disabled="@(busy != null)">
            <Icon Name="refresh" Size="14" />
        </button>
    </div>

    @if (confirmingDelete is { } deleting)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(14, 42, 68, 0.45)">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 460px">
                <div class="modal-content">
                    <div class="modal-header py-2 bg-danger text-white">
                        <h6 class="modal-title"><Icon Name="trash" Size="14" /> Confirm Delete</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="@(() => confirmingDelete = null)"></button>
                    </div>
                    <div class="modal-body">
                        Delete <strong>@deleting.Name</strong>?
                        @if (deleting.IsFolder)
                        {
                            <div class="text-muted small mt-1">Only empty folders can be deleted — the contents are never removed with the folder.</div>
                        }
                        else
                        {
                            <div class="text-muted small mt-1">It will be removed from the network share.</div>
                        }
                    </div>
                    <div class="modal-footer py-2">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => confirmingDelete = null)">Cancel</button>
                        <button class="btn btn-danger btn-sm" @onclick="DeleteConfirmed">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (promptMode != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(14, 42, 68, 0.45)">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px">
                <div class="modal-content">
                    <div class="modal-header py-2" style="background: var(--scc-navy); color: #fff">
                        <h6 class="modal-title">@PromptTitle</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="@(() => promptMode = null)"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label small text-muted">@PromptLabel</label>
                        <input class="form-control" @bind="promptValue" @bind:event="oninput"
                               @onkeyup="@(e => { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(promptValue)) _ = ConfirmPrompt(); })"
                               @ref="promptInput" />
                    </div>
                    <div class="modal-footer py-2">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => promptMode = null)">Cancel</button>
                        <button class="btn btn-primary btn-sm" @onclick="ConfirmPrompt" disabled="@(string.IsNullOrWhiteSpace(promptValue))">OK</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="mb-2">
        <span class="sp-crumb"><Icon Name="home" Size="13" /> <a href="" @onclick="@(() => NavigateTo(-1))" @onclick:preventDefault>Files</a></span>
        @for (var i = 0; i < pathSegments.Count; i++)
        {
            var index = i;
            <span class="text-muted mx-1">/</span>
            @if (index == pathSegments.Count - 1)
            {
                <span>@pathSegments[index]</span>
            }
            else
            {
                <a href="" @onclick="@(() => NavigateTo(index))" @onclick:preventDefault>@pathSegments[index]</a>
            }
        }
    </div>

    <table class="table table-striped sp-table align-middle mb-0">
        <thead>
            <tr>
                <th style="width: 36px"></th>
                <th>File name</th>
                <th>Description</th>
                <th>Date modified</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in entries)
            {
                var state = item.IsFolder ? null : Store.Get(item.RelativePath);
                <tr class="@(selectedPath == item.RelativePath ? "table-active" : null)">
                    <td>
                        <input class="form-check-input" type="checkbox"
                               checked="@(selectedPath == item.RelativePath)"
                               @onchange="@(e => Select(item.RelativePath, (bool)e.Value!))" />
                    </td>
                    <td>
                        @if (item.IsFolder)
                        {
                            <a href="" class="fw-semibold" @onclick="@(() => OpenFolder(item.Name))" @onclick:preventDefault>
                                <Icon Name="folder" Size="14" /> @item.Name
                            </a>
                        }
                        else
                        {
                            <span><Icon Name="file" Size="14" /> @item.Name</span>
                            @if (state != null)
                            {
                                <span class="badge bg-primary ms-2">In SharePoint</span>
                            }
                        }
                    </td>
                    <td class="text-muted">
                        @if (item.IsFolder)
                        {
                            <text>@(item.ChildCount ?? 0) item(s)</text>
                        }
                        else if (state != null)
                        {
                            <text>being edited · opened by @state.CheckedOutBy · last activity @state.LastActivityUtc.ToLocalTime().ToString("t")</text>
                        }
                        else
                        {
                            <text>@((item.SizeBytes ?? 0) / 1024) KB · on network share</text>
                        }
                    </td>
                    <td>@item.ModifiedUtc.ToLocalTime().ToString("g")</td>
                </tr>
            }
            @if (entries.Count == 0)
            {
                <tr><td colspan="4" class="text-muted py-3">This folder is empty.</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<ShareEntry> entries = new();
    private readonly List<string> pathSegments = new();
    private string? selectedPath;
    private string? busy;
    private string? error;
    private string? warning;
    private string? promptMode;   // newdoc | newfolder | rename
    private string promptValue = "";
    private ElementReference promptInput;

    private string CurrentDir => string.Join('/', pathSegments);
    private ShareEntry? Selected => entries.FirstOrDefault(e => e.RelativePath == selectedPath);
    private ShareEntry? SelectedFile => Selected is { IsFolder: false } f ? f : null;
    private ShareEntry? SelectedDocx => SelectedFile is { } f && f.Name.EndsWith(".docx", StringComparison.OrdinalIgnoreCase) ? f : null;
    private DocumentState? SelectedState => SelectedFile is { } f ? Store.Get(f.RelativePath) : null;

    private static bool IsConvertible(string name) =>
        System.Text.RegularExpressions.Regex.IsMatch(name, @"\.(docx?|xlsx?)$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    private string PromptTitle => promptMode switch
    {
        "newdoc" => "New Document",
        "newfolder" => "New Folder",
        "rename" => "Rename",
        _ => ""
    };

    private string PromptLabel => promptMode switch
    {
        "newdoc" => "Document name",
        "newfolder" => "Folder name",
        "rename" => $"New name for '{Selected?.Name}'",
        _ => ""
    };

    protected override void OnInitialized()
    {
        Log.Changed += OnLogChanged;
        Refresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (promptMode != null)
        {
            try { await promptInput.FocusAsync(); } catch { /* not rendered yet */ }
        }
    }

    private void OnLogChanged() => _ = InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    private void Refresh()
    {
        error = null;
        try { entries = Share.List(CurrentDir); }
        catch (Exception ex) { error = ex.Message; entries = []; }
    }

    private void Select(string path, bool isChecked) => selectedPath = isChecked ? path : null;

    private void OpenFolder(string name)
    {
        pathSegments.Add(name);
        selectedPath = null;
        Refresh();
    }

    private void NavigateTo(int index)
    {
        var keep = index + 1;
        pathSegments.RemoveRange(keep, pathSegments.Count - keep);
        selectedPath = null;
        Refresh();
    }

    private void StartPrompt(string mode)
    {
        promptMode = mode;
        promptValue = mode == "rename" ? Selected?.Name ?? "" : "";
    }

    private async Task ConfirmPrompt()
    {
        var mode = promptMode;
        var value = promptValue.Trim();
        promptMode = null;
        if (string.IsNullOrEmpty(value)) return;
        error = null;
        warning = null;
        try
        {
            switch (mode)
            {
                case "newdoc":
                    Share.CreateNew(CurrentDir, value);
                    Log.Info($"Created '{value}' on the network share (as Serfis would).");
                    break;
                case "newfolder":
                    Share.CreateFolder(CurrentDir, value);
                    Log.Info($"Folder '{value}' created on the network share.");
                    break;
                case "rename" when Selected is { } sel:
                    if (!sel.IsFolder && Store.Get(sel.RelativePath) != null)
                    {
                        warning = $"'{sel.Name}' is currently in SharePoint being edited — sync it back before renaming.";
                        break;
                    }
                    Share.Rename(sel.RelativePath, value);
                    Log.Info($"'{sel.Name}' renamed to '{value}'.");
                    break;
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally
        {
            selectedPath = null;
            Refresh();
            await Task.CompletedTask;
        }
    }

    private async Task OnUpload(InputFileChangeEventArgs e)
    {
        busy = "upload";
        error = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            await Share.WriteAsync(string.IsNullOrEmpty(CurrentDir) ? e.File.Name : $"{CurrentDir}/{e.File.Name}", stream);
            Log.Info($"'{e.File.Name}' uploaded to the network share.");
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = null; Refresh(); }
    }

    private async Task ViewSelected()
    {
        if (SelectedDocx is not { } doc) return;
        busy = doc.RelativePath;
        error = null;
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            var user = auth.User.Identity?.Name ?? "unknown user";
            var state = await DocService.CheckoutAsync(doc.RelativePath, user);
            await JS.InvokeVoidAsync("launchUrl", TransientDocumentService.DesktopEditLink(state), false);
        }
        catch (Microsoft.Graph.Models.ODataErrors.ODataError ex) when (ex.ResponseStatusCode == 403)
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            error = $"SharePoint denied access for {auth.User.Identity?.Name}. Scenario 1 edits as the signed-in user, " +
                    "so that user needs baseline access to the document library (in production: membership in the " +
                    "Serfis Editors security group; for this demo: add them under Site permissions → Add members).";
        }
        catch (Exception ex)
        {
            try { ConsentHandler.HandleException(ex); }
            catch { error = ex.Message; }
        }
        finally { busy = null; Refresh(); }
    }

    private async Task SyncSelected()
    {
        if (SelectedState is not { } state) return;
        busy = state.FileName;
        error = null;
        try
        {
            var result = await Sync.TrySyncBackAsync(Graph, state, force: true);
            if (result == SyncResult.Locked)
                warning = "Document is still open in Word/Office Online — close it first (the lock probe protects active editors).";
        }
        catch (Exception ex)
        {
            try { ConsentHandler.HandleException(ex); }
            catch { error = ex.Message; }
        }
        finally { busy = null; Refresh(); }
    }

    private async Task RunSweep()
    {
        busy = "*";
        error = null;
        try
        {
            foreach (var state in Store.All())
                await Sync.TrySyncBackAsync(Graph, state, force: false);
        }
        catch (Exception ex)
        {
            try { ConsentHandler.HandleException(ex); }
            catch { error = ex.Message; }
        }
        finally { busy = null; Refresh(); }
    }

    private ShareEntry? confirmingDelete;

    private void DeleteConfirmed()
    {
        if (confirmingDelete is not { } sel) return;
        confirmingDelete = null;
        error = null;
        warning = null;
        try
        {
            if (sel.IsFolder)
            {
                if (!Share.TryDeleteFolder(sel.RelativePath, out var count))
                    warning = $"Folder '{sel.Name}' was NOT deleted — it still contains {count} item(s). Move or delete its contents first.";
                else
                    Log.Info($"Empty folder '{sel.Name}' deleted from the network share.");
            }
            else if (Store.Get(sel.RelativePath) != null)
            {
                warning = $"'{sel.Name}' is currently in SharePoint being edited — sync it back before deleting.";
            }
            else
            {
                Share.DeleteFile(sel.RelativePath);
                Log.Info($"'{sel.Name}' deleted from the network share.");
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally { selectedPath = null; Refresh(); }
    }

    public void Dispose() => Log.Changed -= OnLogChanged;
}
