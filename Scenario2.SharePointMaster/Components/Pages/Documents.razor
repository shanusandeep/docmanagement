@page "/documents"
@attribute [Authorize]
@inject SealedLibraryService Library
@inject DocumentRegistry Registry
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>Manage Documents — SERFIS</PageTitle>

<h1>Manage Documents</h1>

<button class="btn btn-primary btn-sm mb-3" @onclick="GoBack" disabled="@(pathSegments.Count == 0 || busy != null)">
    <Icon Name="back" Size="12" /> Back
</button>

@if (error != null)
{
    <div class="alert alert-danger py-2">@error</div>
}
@if (warning != null)
{
    <div class="alert alert-warning py-2">@warning</div>
}

<div class="sp-card p-2">

    <div class="sp-toolbar d-flex flex-wrap align-items-center gap-1 border rounded px-2 py-1 mb-2 bg-white">
        <label class="btn btn-sm mb-0 @(busy != null ? "disabled" : null)" title="Upload a file into the current folder">
            @if (busy == "upload")
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            else
            {
                <Icon Name="upload" Size="14" />
            }
            <span class="ms-1">Upload file</span>
            <InputFile OnChange="OnUpload" style="display:none" disabled="@(busy != null)" />
        </label>
        <button class="btn btn-sm" title="Create a new Word document here" @onclick="@(() => StartPrompt("newdoc"))" disabled="@(busy != null)">
            <Icon Name="plus" Size="14" /> <span class="ms-1">New document</span>
        </button>
        <button class="btn btn-sm" title="Create a new folder here" @onclick="@(() => StartPrompt("newfolder"))" disabled="@(busy != null)">
            <Icon Name="folder" Size="14" /> <span class="ms-1">New folder</span>
        </button>
        <button class="btn btn-sm" title="Open the selected document in Word for editing (autosave on)" @onclick="ViewSelected" disabled="@(SelectedFile == null || busy != null)">
            <Icon Name="word" Size="14" /> <span class="ms-1">View/Edit</span>
        </button>
        <button class="btn btn-sm" title="Version history of the selected document" @onclick="ToggleVersions" disabled="@(SelectedFile == null || busy != null)">
            <Icon Name="history" Size="14" /> <span class="ms-1">Versions</span>
        </button>
        @if (SelectedFile != null)
        {
            <a class="btn btn-sm" title="Download the selected document as PDF"
               href="/api/doc/@SelectedFile.Id/pdf?name=@Uri.EscapeDataString(SelectedFile.Name)" target="_blank">
                <Icon Name="pdf" Size="14" /> <span class="ms-1">PDF</span>
            </a>
        }
        else
        {
            <button class="btn btn-sm" disabled><Icon Name="pdf" Size="14" /> <span class="ms-1">PDF</span></button>
        }
        <button class="btn btn-sm" title="Rename the selected item" @onclick="@(() => StartPrompt("rename"))" disabled="@(Selected == null || busy != null)">
            <Icon Name="pencil" Size="14" /> <span class="ms-1">Rename</span>
        </button>
        <button class="btn btn-sm text-danger" title="Delete the selected item" @onclick="DeleteSelected" disabled="@(Selected == null || busy != null)">
            <Icon Name="trash" Size="14" /> <span class="ms-1">Delete</span>
        </button>
        <button class="btn btn-sm ms-auto" title="Refresh" @onclick="LoadAsync" disabled="@(busy != null)">
            <Icon Name="refresh" Size="14" />
        </button>
    </div>

    @if (promptMode != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(14, 42, 68, 0.45)">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 420px">
                <div class="modal-content">
                    <div class="modal-header py-2" style="background: var(--scc-navy); color: #fff">
                        <h6 class="modal-title">@PromptTitle</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="@(() => promptMode = null)"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label small text-muted">@PromptLabel</label>
                        <input class="form-control" @bind="promptValue" @bind:event="oninput"
                               @onkeyup="@(e => { if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(promptValue)) _ = ConfirmPrompt(); })"
                               @ref="promptInput" />
                    </div>
                    <div class="modal-footer py-2">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => promptMode = null)">Cancel</button>
                        <button class="btn btn-primary btn-sm" @onclick="ConfirmPrompt" disabled="@(string.IsNullOrWhiteSpace(promptValue))">OK</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="mb-2">
        <span class="sp-crumb"><Icon Name="home" Size="13" /> <a href="" @onclick="@(() => NavigateTo(-1))" @onclick:preventDefault>Files</a></span>
        @for (var i = 0; i < pathSegments.Count; i++)
        {
            var index = i;
            <span class="text-muted mx-1">/</span>
            @if (index == pathSegments.Count - 1)
            {
                <span>@pathSegments[index].Name</span>
            }
            else
            {
                <a href="" @onclick="@(() => NavigateTo(index))" @onclick:preventDefault>@pathSegments[index].Name</a>
            }
        }
        @if (sampleMode)
        {
            <span class="badge bg-secondary ms-2">sample data — SharePoint not configured yet</span>
        }
    </div>

    <table class="table table-striped sp-table align-middle mb-0">
        <thead>
            <tr>
                <th style="width: 36px"></th>
                <th>File name</th>
                <th>Description</th>
                <th>Date modified</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr class="@(selectedId == item.Id ? "table-active" : null)">
                    <td>
                        <input class="form-check-input" type="checkbox"
                               checked="@(selectedId == item.Id)"
                               @onchange="@(e => Select(item.Id, (bool)e.Value!))" />
                    </td>
                    <td>
                        @if (item.IsFolder)
                        {
                            <a href="" class="fw-semibold" @onclick="@(() => OpenFolder(item))" @onclick:preventDefault>
                                <Icon Name="folder" Size="14" /> @item.Name
                            </a>
                        }
                        else
                        {
                            <span><Icon Name="file" Size="14" /> @item.Name</span>
                        }
                    </td>
                    <td class="text-muted">
                        @if (item.IsFolder)
                        {
                            <text>@(item.ChildCount ?? 0) item(s)</text>
                        }
                        else
                        {
                            <text>@((item.SizeBytes ?? 0) / 1024) KB · @item.ModifiedBy</text>
                        }
                    </td>
                    <td>@item.ModifiedUtc?.ToLocalTime().ToString("g")</td>
                </tr>
            }
            @if (items.Count == 0)
            {
                <tr><td colspan="4" class="text-muted py-3">This folder is empty.</td></tr>
            }
        </tbody>
    </table>

    @if (versionsFor != null && SelectedFile is { } versionDoc)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(14, 42, 68, 0.45)">
            <div class="modal-dialog modal-dialog-centered" style="max-width: 760px">
                <div class="modal-content">
                    <div class="modal-header py-2" style="background: var(--scc-navy); color: #fff">
                        <h6 class="modal-title"><Icon Name="history" Size="14" /> Versions — @versionDoc.Name</h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseVersions"></button>
                    </div>
                    <div class="modal-body">
                        @if (error != null)
                        {
                            <div class="alert alert-danger py-2">@error</div>
                        }
                        @if (versions == null)
                        {
                            <div><span class="spinner-border spinner-border-sm"></span> loading…</div>
                        }
                        else if (versions.Count == 0)
                        {
                            <div class="text-muted">No versions yet.</div>
                        }
                        else
                        {
                            <table class="table table-sm mb-0">
                                <thead><tr><th>#</th><th>Modified</th><th>By</th><th>Size</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var v in versions)
                                    {
                                        <tr>
                                            <td><strong>v@(v.Id)</strong> @(v.IsCurrent ? "· current" : "")</td>
                                            <td>@v.ModifiedUtc?.ToLocalTime().ToString("g")</td>
                                            <td>@v.ModifiedBy</td>
                                            <td>@((v.SizeBytes ?? 0) / 1024) KB</td>
                                            <td>
                                                <a class="btn btn-outline-primary btn-sm @(sampleMode ? "disabled" : null)" title="Open this version"
                                                   href="/api/doc/@versionDoc.Id/versions/@v.Id/content?name=@Uri.EscapeDataString(versionDoc.Name)"><Icon Name="open" /></a>
                                                @if (!v.IsCurrent)
                                                {
                                                    <button class="btn btn-outline-secondary btn-sm" title="Make this version current" @onclick="() => Restore(v.Id)" disabled="@sampleMode">
                                                        <Icon Name="restore" />
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                    <div class="modal-footer py-2 justify-content-between">
                        <label class="btn btn-primary btn-sm mb-0 @(busy != null || sampleMode ? "disabled" : null)" title="Upload a file as the new current version">
                            @if (busy == "verup")
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <Icon Name="upload" Size="14" />
                            }
                            <span class="ms-1">Upload new version</span>
                            <InputFile OnChange="OnUploadNewVersion" style="display:none" disabled="@(busy != null || sampleMode)" />
                        </label>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CloseVersions">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<LibraryDoc> items = new();
    private readonly List<(string Name, string Id)> pathSegments = new();
    private string? selectedId;
    private string? busy;
    private string? error;
    private string? warning;
    private string? promptMode;   // newdoc | newfolder | rename
    private string promptValue = "";
    private string? versionsFor;
    private List<VersionInfo>? versions;
    private bool sampleMode;

    private string CurrentPath => string.Join('/', pathSegments.Select(s => s.Name));
    private string? CurrentFolderId => pathSegments.Count == 0 ? null : pathSegments[^1].Id;
    private LibraryDoc? Selected => items.FirstOrDefault(i => i.Id == selectedId);
    private LibraryDoc? SelectedFile => Selected is { IsFolder: false } f ? f : null;

    private ElementReference promptInput;

    private string PromptTitle => promptMode switch
    {
        "newdoc" => "New Document",
        "newfolder" => "New Folder",
        "rename" => "Rename",
        _ => ""
    };

    private string PromptLabel => promptMode switch
    {
        "newdoc" => "Document name",
        "newfolder" => "Folder name",
        "rename" => $"New name for '{Selected?.Name}'",
        _ => ""
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (promptMode != null)
        {
            try { await promptInput.FocusAsync(); } catch { /* element may not be rendered yet */ }
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        warning = null;
        versionsFor = null;
        versions = null;
        selectedId = null;
        if (!Library.IsConfigured)
        {
            sampleMode = true;
            items = Registry.Documents()
                .Select(d => new LibraryDoc(d.DriveItemId, d.Name, 24_576, d.LastActivityUtc, d.CreatedBy, d.WebUrl))
                .ToList();
            return;
        }
        try
        {
            sampleMode = false;
            items = await Library.ListLibraryAsync(CurrentFolderId);
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void Select(string id, bool isChecked) => selectedId = isChecked ? id : null;

    private async Task OpenFolder(LibraryDoc folder)
    {
        pathSegments.Add((folder.Name, folder.Id));
        await LoadAsync();
    }

    private async Task GoBack()
    {
        if (pathSegments.Count == 0) return;
        pathSegments.RemoveAt(pathSegments.Count - 1);
        await LoadAsync();
    }

    private async Task NavigateTo(int index)
    {
        // -1 = root ("Files"); otherwise keep segments up to and including index
        var keep = index + 1;
        pathSegments.RemoveRange(keep, pathSegments.Count - keep);
        await LoadAsync();
    }

    private void StartPrompt(string mode)
    {
        promptMode = mode;
        promptValue = mode == "rename" ? Selected?.Name ?? "" : "";
    }

    private async Task ConfirmPrompt()
    {
        var mode = promptMode;
        var value = promptValue.Trim();
        promptMode = null;
        if (string.IsNullOrEmpty(value) || sampleMode) return;
        busy = "prompt";
        error = null;
        warning = null;
        try
        {
            var upn = await CurrentUpn();
            switch (mode)
            {
                case "newdoc":
                    await Library.CreateDocumentAsync(value, "Case", upn, CurrentPath);
                    break;
                case "newfolder":
                    await Library.CreateFolderAsync(CurrentFolderId, value);
                    break;
                case "rename" when Selected is { } sel:
                    await Library.RenameAsync(sel.Id, sel.Name, value);
                    break;
            }
            await LoadAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = null; }
    }

    private async Task DeleteSelected()
    {
        if (Selected is not { } sel || sampleMode) return;
        busy = sel.Id;
        error = null;
        warning = null;
        try
        {
            if (sel.IsFolder)
            {
                if (!await Library.TryDeleteFolderAsync(sel.Id, sel.Name))
                    warning = $"Folder '{sel.Name}' was NOT deleted — it still contains {sel.ChildCount ?? 0} item(s). Move or delete its contents first.";
            }
            else
            {
                await Library.DeleteItemAsync(sel.Id, sel.Name);
            }
            await LoadAsync();
            if (warning != null) StateHasChanged();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = null; }
    }

    private async Task<string> CurrentUpn()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        return auth.User.FindFirst("preferred_username")?.Value
               ?? auth.User.Identity?.Name
               ?? throw new InvalidOperationException("No signed-in user.");
    }

    private async Task OnUpload(InputFileChangeEventArgs e)
    {
        if (sampleMode) return;
        busy = "upload";
        error = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            await Library.UploadAsync(e.File.Name, stream, CurrentPath);
            await LoadAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = null; }
    }

    private async Task ViewSelected()
    {
        if (SelectedFile is not { } doc || sampleMode) return;
        busy = doc.Id;
        error = null;
        try
        {
            var registered = Library.EnsureRegistered(doc.Id, doc.Name, doc.WebUrl);
            await Library.GrantAsync(registered, await CurrentUpn(), "write");
            await JS.InvokeVoidAsync("launchUrl", SealedLibraryService.DesktopEditLink(doc), false);
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = null; }
    }

    private async Task ToggleVersions()
    {
        if (SelectedFile is not { } doc) return;
        if (versionsFor == doc.Id) { versionsFor = null; versions = null; return; }
        versionsFor = doc.Id;
        versions = null;
        if (sampleMode)
        {
            versions =
            [
                new VersionInfo("2.0", DateTime.UtcNow.AddMinutes(-40), "Priya Nair", 24_576, true),
                new VersionInfo("1.0", DateTime.UtcNow.AddDays(-1), "Alex Rivera", 19_804, false),
            ];
            return;
        }
        try { versions = await Library.ListVersionsByItemAsync(doc.Id); }
        catch (Exception ex) { error = ex.Message; versionsFor = null; }
    }

    private async Task Restore(string versionId)
    {
        if (SelectedFile is not { } doc) return;
        busy = doc.Id;
        error = null;
        try
        {
            await Library.RestoreVersionByItemAsync(doc.Id, versionId, doc.Name);
            versions = await Library.ListVersionsByItemAsync(doc.Id);
            items = await Library.ListLibraryAsync(CurrentFolderId);   // refresh sizes/dates, keep modal open
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = null; }
    }

    private void CloseVersions()
    {
        versionsFor = null;
        versions = null;
        error = null;
    }

    private async Task OnUploadNewVersion(InputFileChangeEventArgs e)
    {
        if (SelectedFile is not { } doc || sampleMode) return;
        busy = "verup";
        error = null;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            await Library.UploadNewVersionAsync(doc.Id, doc.Name, stream);
            versions = await Library.ListVersionsByItemAsync(doc.Id);
            items = await Library.ListLibraryAsync(CurrentFolderId);   // keep selection and modal open
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = null; }
    }
}
